# Copy to .env.local and fill in. Used only by `npm run data` (scripts/fetch-data.ts).
# The app itself never calls any API at runtime.

# Free key: https://www.alphavantage.co/support/#api-key (S&P 500 via SPY adjusted prices)
ALPHAVANTAGE_API_KEY=

# Free key from your ČNB ARAD account: https://www.cnb.cz/arad/ → Můj účet → Správa API klíčů
# (average savings rates). Leave empty to fall back to a user-adjustable rate.
CNB_ARAD_API_KEY=
